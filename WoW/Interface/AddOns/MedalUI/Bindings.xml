<Bindings>
	<!-- Options > Keybindings > AddOns > MedalUI; Console > Minimap sets it too.
	     The names are in console/minimap.lua. Its default key, Ctrl+M, is also
	     bound once at login where it is free (keybind.lua: DEFAULT_KEYS). -->
	<Binding name="MEDALUI_MINIMAP" header="MEDALUI" category="ADDONS" default="CTRL-M">
		MedalUIToggleMinimap()
	</Binding>
	<!-- quests/log.lua: the quest log key's own keys are bound to it while the
	     Quest log option is on -->
	<Binding name="MEDALUI_QUESTLOG" category="ADDONS">
		MedalUIToggleQuestLog()
	</Binding>
	<!-- social/lfg.lua: the LFG / Who window -->
	<Binding name="MEDALUI_LFG" category="ADDONS">
		MedalUIToggleLFG()
	</Binding>
</Bindings>
